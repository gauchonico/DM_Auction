// DMAuctionHub Uganda — core data model
// Compatible with PostgreSQL on Neon or Supabase (use the pooled connection string for DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled (-pooler): app traffic
  directUrl = env("DATABASE_URL_UNPOOLED") // direct: migrations / db push
}

enum ClientType {
  BANK
  BAILIFF
  RECEIVER
  PRIVATE
}

enum ListingStatus {
  PENDING
  PUBLISHED
  EXPIRED
}

enum MediaType {
  IMAGE
  DOCUMENT
}

model Client {
  id        String     @id @default(cuid())
  name      String
  type      ClientType
  verified  Boolean    @default(false)
  phone     String?
  whatsapp  String?
  email     String?
  listings  Listing[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([type, verified])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  subTypes SubType[]
  listings Listing[]
}

model SubType {
  id         String    @id @default(cuid())
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  listings   Listing[]

  @@unique([categoryId, name])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  listings ListingTag[]
}

model Listing {
  id              String         @id @default(cuid())
  referenceId     String         @unique
  title           String
  description     String         @db.Text
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  subTypeId       String?
  subType         SubType?       @relation(fields: [subTypeId], references: [id], onDelete: SetNull)
  district        String
  locationDetail  String?
  reservePrice    Decimal?       @db.Decimal(16, 2)
  saleDate        DateTime
  deadlineDate    DateTime?
  inspectionNotes String?        @db.Text
  status          ListingStatus  @default(PENDING)
  isFeatured      Boolean        @default(false)
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  tags            ListingTag[]
  media           ListingMedia[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, saleDate])
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([district])
  @@index([clientId])
}

model ListingTag {
  listingId String
  tagId     String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([listingId, tagId])
  @@index([tagId])
}

model ListingMedia {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  caption   String?
  sortOrder Int       @default(0)
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, type, sortOrder])
}

// Captured by the "For Advertisers" page server action.
model AdvertiserEnquiry {
  id           String     @id @default(cuid())
  organisation String
  contactName  String
  phone        String
  email        String?
  clientType   ClientType
  message      String     @db.Text
  handled      Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([handled, createdAt])
}

/* ------------------------------------------------------------------ */
/* Admin panel                                                         */
/* ------------------------------------------------------------------ */

enum StaffRole {
  ADMIN // manages everything, publishes listings, manages staff
  EDITOR // creates/edits listings and media; changes need ADMIN approval
}

model StaffUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         StaffRole      @default(EDITOR)
  active       Boolean        @default(true)
  lastLoginAt  DateTime?
  sessions     StaffSession[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Server-side sessions: the cookie holds a random token, only its SHA-256 hash is stored.
model StaffSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

/* ------------------------------------------------------------------ */
/* Audit trail (append-only: the app only ever inserts)                */
/* ------------------------------------------------------------------ */

enum AuditEntity {
  AUTH
  LISTING
  CLIENT
  CATEGORY
  SUBTYPE
  TAG
  ENQUIRY
  STAFF
}

model AuditLog {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  // Who: linked while the account exists, plus snapshots that survive deletion.
  actorId     String?
  actor       StaffUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String // staff email, the attempted email for failed logins, or "cli"
  actorRole   StaffRole?
  // What
  action      String // dotted verb, e.g. "listing.publish", "auth.login_failed"
  entityType  AuditEntity
  entityId    String?
  entityLabel String? // snapshot, e.g. listing reference or client name
  summary     String
  changes     Json? // { field: { from, to } } or extra details
  // Where from
  ip          String?
  userAgent   String?

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
