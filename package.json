{
  "name": "dmauctionhub-uganda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "media:upload": "dotenv -e .env.local -- tsx scripts/upload-media.ts",
    "admin:create": "dotenv -e .env.local -- tsx scripts/create-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@neon/config": "^1.14.3",
    "@neon/env": "^2.1.6",
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "6.19",
    "@prisma/client": "^6.19.3",
    "lucide-react": "^0.460.0",
    "next": "15.5",
    "react": "19.1",
    "react-dom": "19.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.33",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
