# Neon variables are written to .env.local by `neon deploy` / `neon env pull`.
# Do not copy real values into this file.

# Postgres: pooled (-pooler) for the app, direct for Prisma migrations / db push
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Object Storage (S3-compatible, branch-scoped)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://br-xxx.storage.REGION.aws.neon.tech"
AWS_REGION="eu-central-1"

# --- App settings (add these yourself) ---

# How the app talks to Postgres:
#   websocket (default) — Neon serverless driver over port 443; works where port 5432 is blocked
#   tcp                 — Prisma's native connection over port 5432
# DATABASE_TRANSPORT="websocket"

# Bucket declared in neon.ts (defaults to "assets")
MEDIA_BUCKET="assets"

# Public base URL, used in WhatsApp enquiry messages and metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Fallback WhatsApp number (digits only) for clients with none on file; empty hides the button
WHATSAPP_FALLBACK_NUMBER=""
